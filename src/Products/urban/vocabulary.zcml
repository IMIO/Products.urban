<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="urban"
    >

  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="urban.folder_managers"
      component=".vocabularies.folderManagersVocabularyFactory"
      />

  <utility
      factory=".vocabularies.LicenceStateVocabularyFactory"
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="urban.licence_state"
      />

  <utility
      factory=".vocabularies.UrbanRootLicenceStateVocabularyFactory"
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="urban.rootfolder_licence_state"
      />

  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="urban.vocabularies.procedure_category"
      component=".vocabularies.ProcedureCategoryVocabularyFactory"
      />

  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="urban.vocabularies.licence_types"
      component=".vocabularies.LicenceTypeVocabularyFactory"
      />

  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="urban.vocabularies.licence_tabs"
      component=".vocabularies.LicenceTabsVocabularyFactory"
      />

  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="urban.vocabularies.licence_date_indexes"
      component=".vocabularies.DateIndexVocabularyFactory"
      />

  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="urban.vocabularies.division_names"
      component=".vocabularies.DivisionNamesVocabularyFactory"
      />

  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="urban.vocabularies.division_alternative_names"
      component=".vocabularies.DivisionAlternativeNamesVocabularyFactory"
      />

  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="urban.vocabularies.offdays_types"
      component=".vocabularies.OffDaysTypeVocabularyFactory"
      />

  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="urban.vocabularies.offdays_period_types"
      component=".vocabularies.OffDaysPeriodTypeVocabularyFactory"
      />

  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="urban.vocabularies.weekdays"
      component=".vocabularies.WeekDaysVocabularyFactory"
      />

  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="urban.vocabularies.opinions_to_ask"
      component=".vocabularies.OpinionsToAskVocabularyFactory"
      />

  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="urban.vocabularies.all_opinions_to_ask"
      component=".vocabularies.AllOpinionsToAskVocabularyFactory"
      />

  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="urban.vocabularies.work_types"
      component=".vocabularies.WorkTypesVocabularyFactory"
      />

  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="urban.vocabularies.licence_documents"
      component=".vocabularies.LicenceDocumentsVocabularyFactory"
      />

  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="urban.vocabularies.complementary_delay"
      component=".vocabularies.ComplementaryDelayFactory"
      />

</configure>
