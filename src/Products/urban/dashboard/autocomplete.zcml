<configure
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="urban"
    >

  <browser:view
      name="sreets-autocomplete-suggest"
      provides="eea.faceted.vocabularies.autocomplete.IAutocompleteSuggest"
      for="*"
      class=".autocomplete.UrbanStreetsSuggest"
      permission="zope2.View"
      />

  <browser:view
      name="reference-autocomplete-suggest"
      provides="eea.faceted.vocabularies.autocomplete.IAutocompleteSuggest"
      for="*"
      class=".autocomplete.LicenceReferenceSuggest"
      permission="zope2.View"
      />

  <browser:view
      name="cadastral-autocomplete-suggest"
      provides="eea.faceted.vocabularies.autocomplete.IAutocompleteSuggest"
      for="*"
      class=".autocomplete.CadastralReferenceSuggest"
      permission="zope2.View"
      />

  <browser:view
      name="architects-autocomplete-suggest"
      provides="eea.faceted.vocabularies.autocomplete.IAutocompleteSuggest"
      for="*"
      class=".autocomplete.ArchitectSuggest"
      permission="zope2.View"
      />

  <browser:view
      name="geometricians-autocomplete-suggest"
      provides="eea.faceted.vocabularies.autocomplete.IAutocompleteSuggest"
      for="*"
      class=".autocomplete.GeometricianSuggest"
      permission="zope2.View"
      />

  <browser:view
      name="notaries-autocomplete-suggest"
      provides="eea.faceted.vocabularies.autocomplete.IAutocompleteSuggest"
      for="*"
      class=".autocomplete.NotarySuggest"
      permission="zope2.View"
      />

</configure>
