<configure
    xmlns="http://namespaces.zope.org/zope"
    i18n_domain="urban"
    >

  <!-- Licence worfklow states vocabulary -->
  <utility
      factory=".vocabularies.LicencesWorkflowStates"
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="urban.LicencesWorkflowStates"
      />

    <utility
        factory=".vocabularies.InspectionFollowupVocabulary"
        name="urban.inspection_followups"
        provides="zope.schema.interfaces.IVocabularyFactory"
    />

    <utility
        factory=".vocabularies.TicketFollowupVocabulary"
        name="urban.ticket_followups"
        provides="zope.schema.interfaces.IVocabularyFactory"
    />

  <utility
      factory=".vocabularies.CovidVocabulary"
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="urban.covid"
      />

</configure>
