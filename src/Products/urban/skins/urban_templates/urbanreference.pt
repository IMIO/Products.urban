<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      i18n:domain="plone"
>
  <head><title></title></head>
  <body>

    <!-- String Widgets -->
    <metal:view_macro define-macro="view"
                      tal:define="
                        kssClassesView context/@@kss_field_decorator_view;
                        getKssClasses nocall:kssClassesView/getKssClassesInlineEditable;
                      "
    >
      <span metal:define-macro="string-field-view"
            tal:define="
              kss_class python:getKssClasses(fieldName,
                              templateId='widgets/string', macro='string-field-view');
              uid context/UID|nothing;
              url python:widget.get_reference_url(accessor());
            "
            tal:attributes="
              class kss_class;
              id string:parent-fieldname-$fieldName-$uid;
            "
      >
        <tal:block condition="url">
          <a href=""
             tal:attributes="
               href url;
             "
          >
            <span metal:define-slot="inside"
                  tal:replace="accessor"
            >string</span>
          </a>
        </tal:block>
        <tal:block condition="not: url">
          <span metal:define-slot="inside"
                tal:replace="accessor"
          >string</span>
        </tal:block>
      </span>
    </metal:view_macro>

    <metal:define define-macro="edit">
      <metal:use use-macro="field_macro | context/widgets/field/macros/edit">
        <input class="blurrable firstToFocus"
               id=""
               metal:fill-slot="widget_body"
               name=""
               size="30"
               type="text"
               value=""
               tal:attributes="
                 name fieldName;
                 id fieldName;
                 value value;
                 size widget/size;
                 placeholder widget/placeholder|nothing;
                 maxlength widget/maxlength;
               "
        />
      </metal:use>
    </metal:define>

    <div metal:define-macro="search">
      <div metal:use-macro="context/widgets/string/macros/edit">
      </div>
    </div>

  </body>

</html>
