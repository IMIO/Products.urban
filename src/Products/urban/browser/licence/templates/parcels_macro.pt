<div metal:define-macro="parcels_macro"
     i18n:domain="urban"
>
  <fieldset>
    <legend i18n:translate="concerned_parcels">Concerned parcel(s)</legend>
    <div metal:use-macro="here/@@globalmacros/urbanParcelsMacro"></div>
    <!--div id="urban-coring" class="parcel-action"
             tal:condition="context/getOfficialParcels">
            <a class="coring link-overlay"
               tal:attributes="href python:context.absolute_url() + '/@@parcelcoring'">
                <button class="context apButton">
                    <img src="coring.png"/>
                </button>
            </a>
        </div-->
    <div class="parcel-action">
      <form action="gig_coring_view"
            method="post"
            name="gig_coring"
            target="_blank"
            tal:condition="python: view.isGigCoringActive() "
            tal:attributes="
              action python: context.absolute_url() + '/gig_coring_view';
            "
      >
        <input class="context apButton"
               id="gig_coring_link"
               type="submit"
               value="Lien GIG"
        />
      </form>
    </div>

  </fieldset>
</div>
