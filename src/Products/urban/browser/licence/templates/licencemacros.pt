<fieldset metal:define-macro="urbanBoundLicenceApplicants"
          i18n:domain="urban"
>
  <legend i18n:translate="bound_licence_applicants">Bound licence applicant(s)</legend>
  <div class="#"
       tal:define="
         applicants context/getApplicants;
       "
       tal:attributes="
