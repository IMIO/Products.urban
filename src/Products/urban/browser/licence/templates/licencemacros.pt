<fieldset metal:define-macro="urbanProprietariesMacro"
          i18n:domain="urban"
>
  <legend i18n:translate="proprietaries">Proprietary(ies)</legend>
  <div class="#"
       tal:define="
         proprietaries context/getProprietaries;
       "
       tal:attributes="
         class python: proprietaries and 'field' or 'field warning';
       "
  >
    <p tal:condition="not: proprietaries"
       i18n:translate="warning_add_a_proprietary"
    >
    </p>
    <div>
      <tal:listing content="structure view/renderProprietaryListing" />
    </div>
    <form action="createObject"
          method="post"
          name="quickAdd"
          style="float: left"
          tal:define="
            ctype python: context.portal_types.getTypeInfo('Proprietary');
            member context/@@plone_portal_state/member;
          "
          tal:condition="python: member.has_permission('urban: Add Contact', context)"
          tal:attributes="
            action python: context.absolute_url() + '/createObject';
          "
          i18n:domain="urban"
    >
      <input name="type_name"
             type="hidden"
             value="#"
             tal:attributes="
               value ctype/id;
             "
      />
      <input class="context apButton contenttype-proprietary"
             id="add-proprietary"
             type="submit"
             value="add_a_proprietary"
             i18n:attributes="value"
      />
    </form>
    <form action="createObject"
          method="post"
          name="quickAdd"
          style="float: left"
          tal:define="
            ctype python: context.portal_types.getTypeInfo('ProprietaryCouple');
            member context/@@plone_portal_state/member;
          "
          tal:condition="python: member.has_permission('urban: Add Contact', context)"
          tal:attributes="
            action python: context.absolute_url() + '/createObject';
          "
          i18n:domain="urban"
    >
      <input name="type_name"
             type="hidden"
             value="#"
             tal:attributes="
               value ctype/id;
             "
      />
      <input class="context apButton contenttype-applicant"
             id="add-couple"
             type="submit"
             value="add_a_proprietary_couple"
             i18n:attributes="value"
      />
    </form>
    <form action="createObject"
          method="post"
          name="quickAdd"
          style="float: left"
          tal:define="
            ctype python: context.portal_types.getTypeInfo('CorporationProprietary');
            member context/@@plone_portal_state/member;
          "
          tal:condition="python: member.has_permission('urban: Add Contact', context)"
          tal:attributes="
            action python: context.absolute_url() + '/createObject';
          "
          i18n:domain="urban"
    >
      <input name="type_name"
             type="hidden"
             value="#"
             tal:attributes="
               value ctype/id;
             "
      />
      <input class="context apButton contenttype-proprietary"
             id="add-corporationproprietary"
             type="submit"
             value="add_a_corporationproprietary"
             i18n:attributes="value"
      />
    </form>
  </div>
</fieldset>


