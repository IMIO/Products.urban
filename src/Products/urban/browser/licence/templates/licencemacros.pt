<div metal:define-macro="urbanFolderManagerMacro"
     tal:define="
       folderManagers here/getFoldermanagers;
     "
     i18n:domain="urban"
>
  <tal:loop tal:condition="folderManagers"
            repeat="folderManager folderManagers"
  >
    <span tal:content="folderManager/Title">Treating agent name</span><br />
  </tal:loop>
  <span class="discreet"
        tal:condition="not: folderManagers"
        i18n:translate="content_none"
  >Aucun(e)</span>
</div>


<fieldset metal:define-macro="urbanArchitectsMacro"
          tal:define="
            architects here/getArchitects;
          "
          i18n:domain="urban"
>
  <legend i18n:translate="urban_label_architects">Architect(s)</legend>
  <tal:loop tal:condition="architects"
            repeat="architect architects"
  >
    <div class="#"
         tal:attributes="
           class python: 'clear';
         "
    >
      <a href="#"
         tal:attributes="
           href python: architect.absolute_url() + '?came_from_licence_uid=' + context.UID();
         "
      >
        <span tal:replace="python: architect.getPersonTitle(short=True)"></span>
        <span tal:replace="architect/getName1|nothing"></span>
        <span tal:replace="architect/getName2|nothing"></span>
        <span tal:condition="architect/getSociety"
              tal:replace="python: '(' + architect.getSociety() + ')'"
        ></span>
      </a>
      <br />
      <span tal:content="python: architect.getStreet()+' '+architect.getNumber()"></span><br />
      <span tal:content="python: architect.getZipcode()+' '+architect.getCity()"></span><br />
      <span tal:content="python: architect.getPhone()"></span><br />
    </div>
  </tal:loop>
</fieldset>


