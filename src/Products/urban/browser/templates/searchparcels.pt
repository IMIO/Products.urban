<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      lang="en"
      metal:use-macro="here/main_template/macros/master"
      xml:lang="en"
      i18n:domain="urban"
>


  <metal:block fill-slot="top_slot"
               tal:define="
                 dummy python:request.set('disable_border',1);
               "
  />

  <body>
    <div metal:fill-slot="main">
      <!-- définition des variables -->
      <div tal:define="
             division request/division | nothing;
             section python: request.get('section', '').upper();
             radical python: request.get('radical', '').upper();
             bis python: request.get('bis', '').upper();
             exposant python: request.get('exposant', '').upper();
             puissance python: request.get('puissance', '').upper();
             partie request/partie | nothing;
             location request/location | nothing;
             street_number request/street_number | nothing;
             parcel_owner request/parcel_owner | nothing;
             divisions view/divisions;
             prca request/prca | nothing;
             divname request/divname | nothing;
           "
           i18n:domain="urban"
      >

        <tal:comment replace="nothing">Go back...</tal:comment>
        <metal:listing use-macro="here/@@globalmacros/goBackToMacro" />

        <fieldset style="float:left"><legend i18n:translate="">Search parcel(s)</legend>
          <p tal:condition="not: divisions"
             i18n:translate="help_search_connection_problem"
          >
                        You can not search for parcels for now because there was a problem.
                        Please contact your system administrator and give him the red error message here above
          </p>
          <tal:searchisenabled condition="divisions">
            <p>&nbsp;</p>
            <form action=""
                  method="GET"
            >
              <table class="listing"
                     width="800"
              >
                <thead>
                  <tr>
                    <th colspan="7"><strong i18n:translate="urban_search_by_cadastral_reference">Cadastral reference</strong></th>
                  </tr>
                </thead>
                <tbody>
                  <tr align="center">
                    <td>
                      <label class="discreet"
                             i18n:translate="urban_label_division"
                      >Division</label><br />
                      <select name="division"
                              value="division"
                      >
                        <tal:block condition="python: type(divisions) is list"
                                   repeat="div divisions"
                        >
                          <option tal:content="python: div[1]"
                                  tal:attributes="
                                    selected python: str(div[0]) == division;
                                    value python: div[0];
                                  "
                          ></option>
                        </tal:block>
                      </select>
                    </td>
                    <td>
                      <label class="discreet"
                             i18n:translate="urban_label_section"
                      >Section</label><br />
                      <input maxlength="1"
                             name="section"
                             size="5"
                             style="text-transform: uppercase"
                             type="text"
                             tal:attributes="
                               value section;
                             "
                      />
                    </td>
                    <td>
                      <label class="discreet"
                             i18n:translate="urban_label_radical"
                      >Radical</label><br />
                      <input maxlength="4"
                             name="radical"
                             size="5"
                             type="text"
                             tal:attributes="
                               value radical;
                             "
                      />
                    </td>
                    <td>
                      <label class="discreet"
                             i18n:translate="urban_label_bis"
                      >Bis</label><br />
                                        /
                      <input maxlength="2"
                             name="bis"
                             size="4"
                             type="text"
                             tal:attributes="
                               value bis;
                             "
                      />
                    </td>
                    <td>
                      <label class="discreet"
                             i18n:translate="urban_label_exposant"
                      >Exposant</label><br />
                      <input maxlength="1"
                             name="exposant"
                             size="5"
                             style="text-transform: uppercase"
                             type="text"
                             tal:attributes="
                               value exposant;
                             "
                      />
                    </td>
                    <td>
                      <label class="discreet"
                             i18n:translate="urban_label_puissance"
                      >Puissance</label><br />
                      <input maxlength="3"
                             name="puissance"
                             size="5"
                             type="text"
                             tal:attributes="
                               value puissance;
                             "
                      />
                    </td>
                    <td>
                      <label class="discreet"
                             i18n:translate="urban_label_partie"
                      >Partie</label><br />
                      <input name="partie"
                             type="checkbox"
                             tal:attributes="
                               value partie;
                             "
                      />
                    </td>
                  </tr>
                </tbody>
              </table>

              <table style="margin-bottom: 0em;">
                <tr>
                  <td valign="top"
                      width="390px"
                  >
                    <table class="listing"
                           width="100%"
                    >
                      <thead>
                        <tr>
                          <th>
                            <strong i18n:translate="urban_search_parcel_by_location">Location</strong>
                          </th>
                          <th>
                            <strong i18n:translate="urban_search_parcel_by_street_number">Number</strong>
                          </th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr>
                          <td>
                            <input id="location"
                                   name="location"
                                   type="text"
                                   tal:attributes="
                                     value location;
                                     disabled python: request.get('browse_old_parcels') and 'disabled' or '';
                                   "
                            />
                          </td>
                          <td>
                            <input id="street_number"
                                   name="street_number"
                                   type="text"
                                   tal:attributes="
                                     value street_number;
                                     disabled python: request.get('browse_old_parcels') and 'disabled' or '';
                                   "
                            />
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </td>
                  <td width="20px"></td>
                  <td valign="top"
                      width="390px"
                  >
                    <table class="listing"
                           width="100%"
                    >
                      <thead>
                        <tr>
                          <th>
                            <strong i18n:translate="urban_search_parcel_by_proprietary">Proprietary</strong>
                          </th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr>
                          <td>
                            <input id="parcel_owner"
                                   name="parcel_owner"
                                   type="text"
                                   tal:attributes="
                                     value parcel_owner;
                                     disabled python: request.get('browse_old_parcels') and 'disabled' or '';
                                   "
                            />
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </td>
                </tr>
                <tr>
                  <td colspan="3">
                    <input id="browse_old_parcels"
                           checked="bla"
                           name="browse_old_parcels"
                           onclick="var adress = document.getElementById('location');
                                                var owner = document.getElementById('parcel_owner');
                                                var browse_old_parcels = document.getElementById('browse_old_parcels');
                                                var oldParcels = (browse_old_parcels.getAttribute('checked') != 'checked');
                                                if (oldParcels) {
                                                        owner.setAttribute('disabled', 'disabled');
                                                        adress.setAttribute('disabled', 'disabled');
                                                        browse_old_parcels.setAttribute('checked', 'checked');
                                                }
                                                else {
                                                        adress.removeAttribute('disabled');
                                                        owner.removeAttribute('disabled');
                                                        browse_old_parcels.setAttribute('checked', '');
                                                }"
                           type="checkbox"
                           value="1"
                           tal:attributes="
                             checked python: request.get('browse_old_parcels') and 'checked' or '';
                           "
                    />
                    <label i18n:translate="urban_browse_old_parcels">Browse old parcels (Only works with the parcel reference)</label>
                    <td>
                    </td></td></tr>
              </table><br />
              <input class="context"
                     type="submit"
                     value="Search"
                     i18n:attributes="value urban_button_search;"
              />
            </form>

            <!-- Display results -->
            <tal:block define="
                         results view/search_parcels;
                       "
                       condition="python: results"
            >
              <br />
              <table class="listing"
                     border="0"
                     cellspacing="0"
                     tal:condition="python: results"
              >
                <thead>
                  <tr>
                    <th colspan="3"><span i18n:translate="">Found parcel(s)</span></th>
                  </tr>
                </thead>
                <!-- Display the results body -->
                <tal:block tal:repeat="parcel results">
                  <tr>
                    <td>
                      <img src="old.png"
                           style="padding-right:0.5em"
                           tal:condition="python: getattr(parcel, 'old', None)"
                      />
                      <span tal:content="python: parcel.display()"></span><br />
                      <span tal:define="
                              locations python: parcel.locations.values();
                            "
                            tal:condition="python: hasattr(parcel, 'locations')"
                      >
                        <div tal:repeat="location locations"
                             tal:content="python: location['street_name'] + ' ' + location['number'].decode('utf-8')"
                        ></div>
                      </span>
                      <span tal:define="
                              owners python: parcel.owners.values();
                            "
                            tal:condition="python: hasattr(parcel, 'owners')"
                      >
                        <div tal:repeat="owner owners"
                             tal:content="python: owner['name'] + ' ' + owner['firstname'] + ' ' + owner['street'] + ' ' + owner['number'] + ' ' + owner['zipcode'] + ' ' + owner['city']"
                        ></div>
                      </span>
                    </td>
                    <td>
                      <form action="#"
                            method="post"
                            name="quickAddParcel"
                            tal:attributes="
                              action string: ${context/absolute_url}/searchparcels;
                            "
                            i18n:domain="urban"
                      >
                        <tal:create_owner condition="python: view.contextIsLicence() and hasattr(parcel, 'owners')">
                          <input name="owners"
                                 type="checkbox"
                                 value="#"
                                 tal:attributes="
                                   value python: parcel.owners;
                                 "
                          />
                          <img src="Proprietary.png" />
                        </tal:create_owner>
                        <input name="division"
                               type="hidden"
                               value="#"
                               tal:attributes="
                                 value python: parcel.division;
                               "
                        />
                        <input name="section"
                               type="hidden"
                               value="#"
                               tal:attributes="
                                 value python: parcel.section;
                               "
                        />
                        <input name="radical"
                               type="hidden"
                               value="#"
                               tal:attributes="
                                 value python: parcel.radical;
                               "
                        />
                        <input name="bis"
                               type="hidden"
                               value="#"
                               tal:attributes="
                                 value python: parcel.bis;
                               "
                        />
                        <input name="exposant"
                               type="hidden"
                               value="#"
                               tal:attributes="
                                 value python: parcel.exposant;
                               "
                        />
                        <input name="puissance"
                               type="hidden"
                               value="#"
                               tal:attributes="
                                 value python: parcel.puissance;
                               "
                        />
                        <input name="partie"
                               type="hidden"
                               value="#"
                               tal:attributes="
                                 value partie;
                               "
                        />
                        <input name="old"
                               type="hidden"
                               value="#"
                               tal:attributes="
                                 value python: getattr(parcel, 'old', False);
                               "
                        />
                        <input name="s_division"
                               type="hidden"
                               value="#"
                               tal:attributes="
                                 value python: request.get('division', '');
                               "
                        />
                        <input name="s_section"
                               type="hidden"
                               value="#"
                               tal:attributes="
                                 value python: request.get('section', '');
                               "
                        />
                        <input name="s_radical"
                               type="hidden"
                               value="#"
                               tal:attributes="
                                 value python: request.get('radical', '');
                               "
                        />
                        <input name="s_bis"
                               type="hidden"
                               value="#"
                               tal:attributes="
                                 value python: request.get('bis', '');
                               "
                        />
                        <input name="s_exposant"
                               type="hidden"
                               value="#"
                               tal:attributes="
                                 value python: request.get('exposant', '');
                               "
                        />
                        <input name="s_puissance"
                               type="hidden"
                               value="#"
                               tal:attributes="
                                 value python: request.get('puissance', '');
                               "
                        />
                        <input name="s_location"
                               type="hidden"
                               value="#"
                               tal:attributes="
                                 value python: request.get('location', '');
                               "
                        />
                        <input name="s_street_number"
                               type="hidden"
                               value="#"
                               tal:attributes="
                                 value python: request.get('street_number', '');
                               "
                        />
                        <input name="s_parcel_owner"
                               type="hidden"
                               value="#"
                               tal:attributes="
                                 value python: request.get('parcel_owner', '');
                               "
                        />
                        <input alt="Add this parcel"
                               name="add_parcel"
                               src="icon_add.gif"
                               type="image"
                        />
                      </form>
                    </td>
                  </tr>
                </tal:block>
              </table>
            </tal:block>
          </tal:searchisenabled>
        </fieldset>

      </div>

      <!-- Display the list of already added parcels -->
      <fieldset style="float:left"><legend i18n:translate="concerned_parcels">Concerned parcel(s)</legend>
        <div>
          <tal:listing content="structure view/renderParcelsListing" />
        </div>
      </fieldset>

    </div>

  </body>
</html>
