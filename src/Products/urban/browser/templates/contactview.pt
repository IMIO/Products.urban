<html xmlns="http://www.w3.org/1999/xhtml"
      lang="en"
      metal:use-macro="here/main_template/macros/master"
      xml:lang="en"
      i18n:domain="urban"
>

  <body>
    <metal:main fill-slot="main">
      <metal:main_macro define-macro="main">
        <metal:body define-macro="body_macro">

          <metal:titlewithicon use-macro="here/@@globalmacros/titleWithIcon" />

          <div tal:replace="structure provider:plone.belowcontenttitle"></div>
          <!-- Back to the build licence... -->
          <br />
          <a class="no_underline"
             href="#"
             tal:attributes="
               href view/getLinkToLinkedLicence;
             "
          >
            <img src="goback.png" />&nbsp;<span i18n:translate="go_back">Go back</span>...
          </a>

          <fieldset>
            <legend tal:content="view/getContactLegendValue"
                    i18n:translate=""
            >Contact Data</legend>
            <table class="no-style-table"
                   cellpadding="0"
                   cellspacing="0"
                   metal:define-slot="detail_slot"
                   width="100%"
                   tal:define="
                     default_custom python: [];
                     default_exclude python: ['id'];
                     custom custom | python: [];
                     custom python: custom + default_custom;
                     exclude exclude | default_exclude;
                   "
            >

              <tal:loop repeat="field python: view.getFields(exclude)">
                <metal:field_display use-macro="here/@@contactmacros/field_display" />
              </tal:loop>
            </table>
          </fieldset>

        </metal:body>
      </metal:main_macro>
    </metal:main>
  </body>
</html>
