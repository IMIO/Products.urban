<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      i18n:domain="atreferencebrowserwidget"
>
  <head>
  </head>
  <body class="popup atrefbrowser"
        id="atrefbrowserpopup"
        style="font-size: 150% !important"
        tal:define="
          fieldName view/fieldName;
          multiValued view/multiValued;
          fieldRealName view/fieldRealName;
          at_obj nocall:view/at_obj;
          widget nocall:view/widget;
          title python:widget.Label(at_obj);
          search_index view/search_index;
          search_text view/search_text;
          wildcardable_indexes view/wildcardable_indexes;
          wildcardable_indexes_as_json view/wildcardable_indexes_as_json;
          available_indexes widget/available_indexes;
          allow_browse widget/allow_browse;
          image_portal_types widget/image_portal_types;
          image_method widget/image_method|string:image_icon;
        "
  >

    <div id="atrefbrowserpopup-top-helper"
         tal:condition="widget/top_popup_helper"
         tal:content="structure widget/top_popup_helper"
         i18n:translate=""
    ></div>

    <div id="messageWrapper"
         style="position: relative"
    >
      <div style="position: absolute; width: 100%">
        <dl class="portalMessage info"
            id="messageAdded"
            style="display:none; margin-top:0"
        >
          <dt i18n:translate="referencebrowser_text_added_reference">Added</dt>
          <dd></dd>
        </dl>
      </div>
      <div style="position: absolute; width: 100%">
        <dl class="portalMessage info"
            id="messageRemoved"
            style="display:none; margin-top:0"
        >
          <dt i18n:translate="referencebrowser_text_removed_reference">Removed</dt>
          <dd></dd>
        </dl>
      </div>
    </div>

    <!-- Search form -->
    <form id="search"
          action="search"
          method="post"
          name="search"
          style="text-align: right;"
          tal:attributes="
            action request/getURL;
          "
    >
      <tal:formactions tal:condition="widget/allow_search">
        <div class="field">
          <tal:indexes condition="widget/show_indexes">
            <label i18n:translate="referencebrowser_search_index_label">
             Search index
            </label>
            <select id="indexSelector"
                    name="search_index"
            >
              <tal:indexes tal:repeat="index view/filtered_indexes">
                <option selected
                        value=""
                        tal:condition="python:available_indexes.has_key(index)"
                        tal:content="python:available_indexes[index]"
                        tal:attributes="
                          value index;
                          selected python:index==search_index and 'selected' or '';
                        "
                ></option>

                <option selected
                        value=""
                        tal:condition="python:not available_indexes.has_key(index)"
                        tal:content="index"
                        tal:attributes="
                          value index;
                          selected python:index==search_index and 'selected' or '';
                        "
                ></option>
              </tal:indexes>
            </select>
          </tal:indexes>

          <input id="searchGadget"
                 name="searchValue"
                 placeholder="Search Site"
                 size="25"
                 title="Search Site"
                 type="text"
                 value=""
                 tal:attributes="
                   value search_text;
                 "
                 i18n:attributes="title referencebrowser_search_site;
                                placeholder referencebrowser_search_site"
          />
          <input class="searchButton"
                 name="submit"
                 type="submit"
                 value="Search"
                 i18n:attributes="value label_search;"
                 i18n:domain="plone"
          />
          &nbsp;<span id="searchWildcardHelp"
                style="font-weight: bold; color: grey; border-bottom: 1px dotted; cursor: help;"
                title="#"
                data-wildcardableindexes="#"
                tal:condition="python: search_index in wildcardable_indexes"
                tal:attributes="
                  title view/wildcard_help_message;
                  data-wildcardableIndexes wildcardable_indexes_as_json;
                "
                i18n:attributes="title"
          >?</span>
        </div>
      </tal:formactions>

      <!-- add these to make sure that after a search result, we still have
          these paremeters -->
      <input name="fieldName"
             type="hidden"
             value=""
             tal:attributes="
               value fieldName;
             "
      />
      <input name="fieldRealName"
             type="hidden"
             value=""
             tal:attributes="
               value fieldRealName;
             "
      />
      <input name="at_url"
             type="hidden"
             value=""
             tal:attributes="
               value view/at_url;
             "
      />
      <input name="multiValued"
             type="hidden"
             value=""
             tal:attributes="
               value multiValued;
             "
      />
      <input name="close_window"
             type="hidden"
             value=""
             tal:attributes="
               value view/close_window;
             "
      />
    </form>
    <!-- actual list of objects, either searchresults or folder contents -->
    <div id="atrbResults"
         tal:define="
           batch view/getResult;
         "
    >
      <div class="field">
        <form action="http://localhost:8081/Plone/urban/notaries/createObject"
              method="post"
              name="quickAdd"
              target="_blank"
        >
          <input name="type_name"
                 type="hidden"
                 value="Notary"
          />
          <input class="context contenttype-notary"
                 id="event"
                 type="submit"
                 value="Encoder un nouveau Notaire"
          />
        </form>
      </div>
      <!-- history -->
      <div style="float: right; clear: right;"
           tal:condition="python:widget.history_length > 0"
      >
        <form id="history"
              action="referencebrowser_popup"
              name="history"
        >
          <label for="path"
                 i18n:translate="referencebrowser_history"
          >History</label>
          <select name="path">
          </select>
          <noscript>
            <input class="context"
                   name="go"
                   type="button"
                   value="Go"
                   i18n:attributes="value label_go"
            />
          </noscript>
        </form>
      </div>

      <!-- breadcrumbs -->
      <div style="margin-bottom: 1em"
           tal:define="
             isRTL here/@@plone_portal_state/is_rtl;
           "
           tal:condition="python:search_text=='' and allow_browse"
      >

        <span id="breadcrumbs-you-are-here"
              i18n:domain="plone"
              i18n:translate="you_are_here"
        >You are here:</span>
        <tal:crumbs tal:repeat="crumb view/breadcrumbs">

          <a class="browsesite"
             tal:attributes="
               href crumb/absolute_url;
               rel crumb/Title;
             "
          >
            <span tal:content="crumb/Title"
                  i18n:translate=""
            >
              Breadcrumb Title
            </span>
          </a>

          <span class="breadcrumbSeparator"
                tal:condition="not: repeat/crumb/end"
          >
            <tal:ltr condition="not: isRTL">&rarr;</tal:ltr>
            <tal:rtl condition="isRTL">&larr;</tal:rtl>
          </span>

        </tal:crumbs>

      </div>

      <!-- object list -->
      <p id="atrbNoResults"
         tal:condition="not:view/has_queryresults"
         i18n:translate="referencebrowser_no_items_found"
      >No items found.</p>

      <table class="group"
             id="atrbResultsTable"
             cellpadding="2"
             cellspacing="0"
             width="100%"
             tal:condition="batch"
      >
        <colgroup>
          <col width="20px" />
          <col />
        </colgroup>
        <tbody>
          <tal:results tal:define="
                         plone_view context/@@plone;
                         normalizeString nocall:plone_view/normalizeString;
                       "
                       tal:repeat="info batch"
          >
            <tal:row tal:define="
                       item info/item;
                       uid python:view.getUid(item);
                       isNotSelf python:view.isNotSelf(item);
                       referenceable info/referenceable;
                       browsable python:allow_browse and info['browsable'];
                       title_or_id python:view.title_or_id(item);
                       color view/discreetColor;
                     ">

              <tr tal:define="
                    oddrow repeat/info/odd;
                  "
                  tal:attributes="
                    class python:oddrow and 'even' or 'odd';
                  "
              >

                <td>
                  <tal:referenceable tal:condition="referenceable">
                    <input class="insertreference"
                           type="checkbox"
                           tal:attributes="
                             id uid;
                             rel uid;
                           "
                    />
                  </tal:referenceable>
                </td>

                <td tal:condition="image_portal_types">
                  <label tal:omit-tag="not: referenceable"
                         tal:attributes="
                           for uid;
                         "
                  >
                    <img tal:condition="python: item.Type in image_portal_types"
                         tal:attributes="
                           src string:${item/getURL}/$image_method;
                         "
                    />
                  </label>
                </td>
                <td tal:attributes="
                      class python:'contenttype-' + normalizeString(item.portal_type);
                    ">
                  <img tal:define="
                         icon item/getIcon;
                       "
                       tal:condition="icon"
                       tal:attributes="
                         src string:${view/portal_url}/$icon;
                       "
                  />
                  <a class="browsesite"
                     tal:condition="browsable"
                     tal:attributes="
                       href python:view.genRefBrowserUrl(item.getURL());
                       rel item/Title;
                     "
                  >
                    <label tal:condition="referenceable"
                           tal:content="title_or_id"
                           tal:attributes="
                             for uid;
                           "
                    >Title</label>
                    <span tal:condition="not:referenceable"
                          tal:content="title_or_id"
                    ></span>
                  </a>
                  <tal:foldercheck tal:condition="
              python:not(browsable and isNotSelf)">
                    <label tal:condition="referenceable"
                           tal:content="title_or_id"
                           tal:attributes="
                             for uid;
                           "
                    >Title
                    </label>
                    <span tal:condition="not:referenceable"
                          tal:content="title_or_id"
                    ></span>
                  </tal:foldercheck>
                  <a class="discreet"
                     onclick="window.open(jQuery(this).attr('href'));return false;"
                     tal:condition="referenceable"
                     tal:attributes="
                       href python:view.preview_url(item);
                     "
                  >
                    (<span i18n:domain="plone"
                          i18n:translate=""
                    >View</span>)
                  </a>

                  <div tal:condition="widget/show_review_state">
                    <span tal:define="
                            state item/review_state;
                          "
                          tal:content="state"
                          tal:attributes="
                            class python:'state-' + normalizeString(state);
                          "
                          i18n:domain="plone"
                          i18n:translate=""
                    ></span>
                  </div>

                  <div class="additionalInfo"
                       tal:content="
              structure item/additionalReferenceInfo | nothing"
                  ></div>
                </td>
              </tr>
            </tal:row>
          </tal:results>
        </tbody>
      </table>

      <tal:var tal:define="
                 template_id view/__name__;
               ">
        <div metal:use-macro="here/batch_macros/macros/navigation"></div>
      </tal:var>

      <div id="atrefbrowserpopup-bottom-helper"
           tal:condition="widget/bottom_popup_helper"
           tal:content="structure widget/bottom_popup_helper"
           i18n:translate=""
      ></div>

    </div>
  </body>
</html>
