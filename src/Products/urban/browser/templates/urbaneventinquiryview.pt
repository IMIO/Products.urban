<html xmlns="http://www.w3.org/1999/xhtml"
      lang="en"
      metal:use-macro="here/main_template/macros/master"
      xml:lang="en"
      i18n:domain="urban"
>
  <head>
    <metal:block fill-slot="top_slot"
                 tal:define="
                   member context/@@plone_portal_state/member;
                   border python: member.has_permission('Modify portal content', context) and 'enable_border' or 'disable_border';
                   dummy python:request.set(border, 1);
                 "
    />
  </head>

  <body>
    <metal:core fill-slot="content-core">
      <metal:main_macro define-macro="main">
        <metal:body define-macro="body_macro"
                    tal:define="
                      useTabbing python: True;
                      member context/@@plone_portal_state/member;
                      recipients context/getRecipients;
                      global parcels view/getParcels;
                    "
        >
          <div id="messageWrapper"
               style="position: relative"
               tal:define="
                 mail_send view/mail_send;
               "
               tal:condition="view/mail_send"
          >
            <dl class="portalMessage info">
              <dt i18n:domain="plone"
                  i18n:translate=""
              >Info</dt>
              <dd tal:content="mail_send"></dd>
            </dl>
          </div>
          <div class="action-bar">
            <metal:listing use-macro="here/@@globalmacros/goBackToMacro" />
            <div class="action-bar-text"
                 tal:define="
                   state view/get_state;
                 "
                 i18n:domain="plone"
            >
              <span i18n:translate="">State</span>:
              <span tal:attributes="
                      class python: 'urban_state_%s' % state.replace(' ', '');
                    ">
                <tal:state content="state"
                           i18n:translate=""
                />
              </span>
            </div>
            <div class="urban_transitions">
              <span class="urban_transitions_text"
                    i18n:translate=""
              >Transitions:</span>
              <tal:actions content="structure here/transitions_panel" />
            </div>
            <div class="urban_actions">
              <span class="urban_transitions_text"
                    i18n:translate=""
              >Actions:</span>
              <tal:actions content="structure here/actions_panel" />
            </div>
            <div class="visualClear"></div>
          </div>

          <div id="urbanViewWithTabbing"
               tal:condition="useTabbing"
          >
            <dl class="formTabs enableFormTabbing">
              <dt class="formTab"
                  id="fieldsetlegend-event_inquiry_documents"
                  i18n:translate="event_inquiry_documents"
              ><span>Description</span></dt>
              <dd id="fieldset-event_inquiry_documents">
                <table style="margin-top:10px"
                       width="100%"
                >
                  <tr valign="top">
                    <td>
                      <metal:listing use-macro="context/@@urbanevent-macros/urbanEventDataMacro" />
                      <metal:listing use-macro="context/@@urbanevent-macros/urbanEventGenerateDocumentMacro" />
                    </td>

                    <td style="width: 1%"></td>

                    <td>
                      <fieldset tal:define="
                                  context view/getLinkedInquiry;
                                "
                                tal:condition="python: context"
                      >
                        <legend i18n:translate="inquiry_data">Inquiry data</legend>
                        <p class="discreet"
                           i18n:translate="urban_context_help"
                        >
                                                Here above are data defined for the inquiry.
                                                If you want to change these informations, click on the name of the linked inquiry here above.
                        </p>
                        <tal:comment replace="nothing">Keep context as name of the obj here as some widget rendering will fail if not...</tal:comment>
                        <table class="no-style-table"
                               tal:define="
                                 fields view/getInquiryFields;
                               "
                        >
                          <tr valign="top">
                            <td>
                              <strong i18n:translate="urban_label_context">Linked inquiry</strong>:&nbsp;&nbsp;&nbsp;&nbsp;
                            </td>
                            <td>
                              <a href="#"
                                 tal:content="view/getLinkedInquiryTitle"
                                 tal:attributes="
                                   href view/getLinkToTheInquiries;
                                 "
                              >
                                                            Linked inquiry title and number
                              </a>
                            </td>
                          </tr>
                          <tal:evtfield repeat="field fields">
                            <tr valign="top"
                                tal:define="
                                  field_name python: field.__name__;
                                  field_label python: str(field.widget.label);
                                "
                            >
                              <td>
                                <strong tal:content="field_label"
                                        i18n:translate=""
                                >
                                                                Inquiry field label
                                </strong>:&nbsp;&nbsp;&nbsp;&nbsp;
                              </td>
                              <tal:manage_show_nc_if_needed define="
                                                              value python: field.getAccessor(context)();
                                                            ">
                                <td tal:condition="value">
                                  <metal:myfield use-macro="python: context.widget(field_name, mode='view')" />
                                </td>
                                <td tal:condition="not: value">
                                  <span class="discreet"
                                        tal:condition="not: value"
                                        i18n:translate="content_none"
                                  >Aucun(e)</span>
                                </td>
                              </tal:manage_show_nc_if_needed>
                            </tr>
                          </tal:evtfield>
                        </table>
                      </fieldset>
                      <fieldset tal:define="
                                  inqReclamationNumbers view/getInquiryReclamationNumbers;
                                "
                                tal:condition="inqReclamationNumbers"
                      >
                        <legend>Total des r&eacute;clamations par type</legend>
                        <div style="margin-top:40px"
                             tal:define="
                               inqOral python: inqReclamationNumbers[0];
                               inqWrited python: inqReclamationNumbers[1];
                             "
                        >
                          <div>
                            <strong tal:content="python: 'urban_label_investigationOralReclamationNumber'"
                                    i18n:translate=""
                            >
                                                        Optional field label
                            </strong>:&nbsp;<strong>
                              <span tal:content="inqOral"></span></strong>
                          </div>
                          <div>
                            <strong tal:content="python: 'urban_label_investigationWriteReclamationNumber'"
                                    i18n:translate=""
                            >
                                                        Optional field label
                            </strong>:&nbsp;<strong>
                              <span tal:content="inqWrited"></span></strong>
                          </div>
                        </div>
                      </fieldset>
                      <fieldset>
                        <legend i18n:translate="event_linked_documents">Event linked documents</legend>
                        <div class="clear"
                             style="margin-top:10px"
                        >
                          <tal:listing content="structure view/renderGeneratedDocumentsListing" />
                        </div>
                      </fieldset>
                      <fieldset>
                        <legend i18n:translate="event_linked_attachments">Event linked attachments</legend>
                        <div class="clear"
                             style="margin-top:10px"
                        >
                          <tal:listing content="structure view/renderAttachmentsListing" />
                          <metal:listing use-macro="context/@@urbanevent-macros/urbanEventAddAttachmentMacro" />
                        </div>
                      </fieldset>
                    </td>
                  </tr>
                </table>
              </dd>

              <dt class="formTab"
                  id="fieldsetlegend-event_inquiry_claimants"
                  i18n:translate="event_inquiry_claimants"
              >
                <span>Claimants</span>
              </dt>
              <dd id="fieldset-event_inquiry_claimants">
                <form method="post"
                      name="quickAdd"
                      tal:define="
                        ctype python: context.portal_types.getTypeInfo('Claimant');
                        member context/@@plone_portal_state/member;
                      "
                      tal:condition="python: member.has_permission('urban: Add Claimant', context)"
                      tal:attributes="
                        action python: context.absolute_url() + '/createObject';
                      "
                      i18n:domain="urban"
                      class="contact-icon"
                >
                  <input name="type_name"
                         type="hidden"
                         value="#"
                         tal:attributes="
                           value ctype/id;
                         "
                  />
                  <input class="context"
                         id="event"
                         type="submit"
                         value="add_a_claimant"
                         i18n:attributes="value"
                  />
                  <br /><br />
                </form>

                <div tal:define="
                       claimants context/getClaimants;
                     ">
                  <table class="listing"
                         style="margin-bottom: 0;"
                         width="100%"
                  >
                    <thead>
                      <tr>
                        <th colspan="4">
                          <span i18n:translate="number_of_claimants">Number of claimants</span>
                           :
                          <strong><span tal:content="python: len(claimants)"></span></strong>
                        </th>
                      </tr>
                    </thead>
                  </table>
                  <div>
                    <tal:listing content="structure view/renderClaimantsListing" />
                  </div>
                </div>

                <tal:import_claimants_form define="
                                             form python: view.import_claimants_listing_form;
                                           ">
                  <tal:with-form-as-view define="
                                           view nocall:form;
                                         ">
                    <metal:block use-macro="form/@@ploneform-macros/titlelessform" />
                  </tal:with-form-as-view>
                </tal:import_claimants_form>

              </dd>

              <dt class="formTab"
                  id="fieldsetlegend-urbaneventinquiry_recipients"
                  i18n:translate="event_inquiry_recipients"
              ><span>Recipients</span></dt>
              <dd id="fieldset-urbaneventinquiry_recipients">
                <tal:block condition="python: member.has_permission('Modify portal content', context)">
                  <form method="post"
                        tal:attributes="
                          action context/absolute_url;
                        "
                  >
                    <input class="context"
                           name="find_recipients_cadastre"
                           type="submit"
                           tal:attributes="
                             value python:'Rechercher les propriétaires situés dans un rayon de {radius}m'.format(
                                                                 radius=view.getInquiryRadius());
                           "
                    />
                    <input class="context"
                           name="find_address_cadastre"
                           type="submit"
                           tal:attributes="
                             value python:'Rechercher les adresses situés dans un rayon de {radius}m'.format(
                                                                 radius=view.getInquiryRadius());
                           "
                    />
                  </form>
                </tal:block>
                <br />
                <tal:recipients condition="recipients">
                  <table class="listing"
                         style="margin-bottom: 0;"
                         width="100%"
                  >
                    <thead>
                      <tr>
                        <th colspan="4">
                          <span i18n:translate="number_of_recipients">Number of recipients</span>
                           :
                          <strong><span tal:content="python: len(recipients)"></span></strong>
                        </th>
                      </tr>
                    </thead>
                  </table>
                  <div>
                    <tal:listing content="structure view/renderRecipientsCadastreListing" />
                  </div>
                </tal:recipients>
                <tal:block condition="python: member.has_permission('Modify portal content', context)">
                  <form method="post"
                        name="quickAdd"
                        tal:condition="python: member.has_permission('urban: Add RecipientCadastre', context)"
                        tal:attributes="
                          action python: context.absolute_url() + '/createObject?type_name=RecipientCadastre';
                        "
                  >
                    <input class="context"
                           id="event"
                           type="submit"
                           value="Add recipientcadastre manually"
                           i18n:attributes="value"
                    />
                  </form>
                  <p>&nbsp;</p>
                </tal:block>

                <tal:import_recipients_form define="
                                              form python: view.import_recipients_listing_form;
                                            ">
                  <tal:with-form-as-view define="
                                           view nocall:form;
                                         ">
                    <metal:block use-macro="form/@@ploneform-macros/titlelessform" />
                  </tal:with-form-as-view>
                </tal:import_recipients_form>

                <tal:block condition="python: context.REQUEST.get('template_uid') != None">
                  <tal:block define="
                               docObj python:context.uid_catalog(UID=context.REQUEST.get('template_uid'))[0];
                             ">
                    <script tal:content="python:'document.location = \''+docObj.getObject().absolute_url()+'/external_edit\';'"></script>
                  </tal:block>
                </tal:block>
              </dd>
            </dl></div>
        </metal:body>
      </metal:main_macro>
    </metal:core>
  </body>
</html>
