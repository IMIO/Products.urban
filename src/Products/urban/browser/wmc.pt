<?xml version="1.0" encoding="UTF-8"?>
<viewcontext xmlns="http://www.opengis.net/context"
             xmlns:tal="http://xml.zope.org/namespaces/tal"
             xmlns:xlink="http://www.w3.org/1999/xlink"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="mum2_ogc_workshop"
             version="1.0.0"
             xsi:schemalocation="http://www.opengis.net/context http://schemas.opengis.net/context/1.0.0/context.xsd"
>
  <general>
    <window height="500"
            width="70%"
    ></window>
    <boundingbox srs="EPSG:31370"
                 tal:attributes="
                   minx view/minx;
                   miny view/miny;
                   maxx view/maxx;
                   maxy view/maxy;
                 "
    ></boundingbox>
    <title>Urbanmap WMS</title>
    <keywordlist></keywordlist>
    <abstract></abstract>
  </general>
  <layerlist>
    <layer tal:repeat="layer view/getLayers"
           tal:attributes="
             hidden layer/hidden;
             queryable layer/queryable;
           "
    >
      <server service="WMS"
              title="Geoserver"
              version="1.1.0"
      >
        <onlineresource xlink:type="simple"
                        tal:attributes="
                          xlink:href layer/url;
                        "
        ></onlineresource>
      </server>
      <name tal:content="layer/name">urban12345:capa</name>
      <title tal:content="layer/title">Parcellaire</title>
      <abstract></abstract>
      <srs tal:content="layer/srs">EPSG:31370</srs>
      <formatlist>
        <format current="1"
                tal:content="layer/format"
        >image/png</format>
      </formatlist>
      <stylelist>
        <style current="1">
        <Name tal:content="layer/style"></Name>
        <Title tal:content="layer/style"></Title>
        </style>
      </stylelist>
      <extension>
        <ol:units xmlns:ol="http://openlayers.org/context">m</ol:units>
        <ol:isbaselayer xmlns:ol="http://openlayers.org/context">false</ol:isbaselayer>
        <ol:transparent xmlns:ol="http://openlayers.org/context"
                        tal:content="layer/transparency"
        >true</ol:transparent>
      </extension>
    </layer>
  </layerlist>
</viewcontext>
