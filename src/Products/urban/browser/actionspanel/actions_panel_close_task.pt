<td class="noPadding"
    i18n:domain="urban"
>
  <input class="overlay-task-action close_task"
         type="button"
         value="End"
         tal:condition="python: context.get_state() != 'closed'"
         tal:attributes="
           href string:${context/absolute_url}/@@close_task;
         "
         i18n:attributes="value"
  />
</td>
