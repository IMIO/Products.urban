<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="collective.exportimport"
>

  <div metal:fill-slot="main">
    <tal:main-macro metal:define-macro="main">

      <h1 class="documentFirstHeading"
          i18n:translate=""
      >Export Urban Config</h1>

      <p class="documentDescription"
         i18n:translate=""
      >Select which urban config to export as a json-file.</p>

      <form id="export_content"
            action="@@export_content"
            enctype="multipart/form-data"
            method="post"
            tal:attributes="
              action request/URL;
            "
      >

        <div class="field mb-3">
          <label for="portal_type">
            <span i18n:translate="">Content Types to export</span>
          </label>
          <div class="widget"
               id="portal_type"
          >
            <input class="checkboxType"
                   id="checkall"
                   name="checkall"
                   title="Toggle all"
                   type="checkbox"
                   i18n:attributes="title label_toggle"
            />
            <label for="checkall"><i i18n:translate="">Select all/none</i></label><br />
            <script type="text/javascript">
                   // Check or Uncheck All checkboxes
                   $("#checkall").change(function(){
                     var checked = $(this).is(':checked');
                     if(checked){
                       $("form#export_content #portal_type input[type='checkbox']").each(function(){
                         $(this).prop("checked",true);
                       });
                     }else{
                       $("form#export_content #portal_type input[type='checkbox']").each(function(){
                         $(this).prop("checked",false);
                       });
                     }
                   });

                  // Changing state of CheckAll checkbox
                  $("form#export_content").on("click", "form#export_content #portal_type input[name='portal_type']", function(){
                    if($("form#export_content #portal_type input[type='checkbox']").length == $("form#export_content #portal_type input[type='checkbox']:checked").length) {
                      $("#checkall").prop("checked", true);
                    } else {
                      $("#checkall").prop("checked", false);
                    }

                  });
            </script>
            <tal:types tal:repeat="ptype python: view.portal_types()">
              <input class="checkboxType"
                     name="portal_type"
                     type="checkbox"
                     tal:attributes="
                       value ptype/value;
                       id ptype/value;
                     "
              />
              <label tal:content="string:${ptype/title} - ${ptype/value} (${ptype/number})"
                     tal:attributes="
                       for ptype/value;
                     "
              ></label>
              <br />
            </tal:types>
          </div>
        </div>

        <div class="field mb-3">
          <label for="path"
                 i18n:translate=""
          >Path</label>
          <div class="widget">
            <input id="path"
                   name="path"
                   type="text"
                   value=""
                   tal:attributes="
                     value python:view.path;
                   "
            />
          </div>
        </div>

        <div class="field mb-3">
          <label for="depth"
                 i18n:translate=""
          >Depth</label>
          <span class="formHelp"
                i18n:translate=""
          >Unlimited: this item and all children, 0: this object only, 1: only direct children of this object, 2-x: children of this object up to the specified level</span>
          <div class="widget">
            <select class=""
                    name="depth"
            >
              <option value="1"
                      tal:repeat="current python:view.depth_options"
                      tal:content="python:current[1]"
                      tal:attributes="
                        value python: current[0];
                        selected python:'selected' if int(current[0]) == view.depth else False;
                      "
              >
                        1
              </option>
            </select>
          </div>
        </div>

        <div class="field mb-3">
          <div class="form-check">
            <input class="form-check-input"
                   id="download_local"
                   checked="checked"
                   name="download_to_server:int"
                   type="radio"
                   value="0"
            />
            <label class="form-check-label"
                   for="download_local"
                   i18n:translate=""
            >
                  Download to local machine
            </label>
          </div>
          <div class="form-check">
            <input class="form-check-input"
                   id="download_server"
                   name="download_to_server:int"
                   type="radio"
                   value="1"
            />
            <label class="form-check-label"
                   for="download_server"
                   i18n:translate=""
            >
                  Save to file on server
            </label>
          </div>
        </div>


        <div class="form-group">
          <input name="form.submitted"
                 type="hidden"
                 value="1"
          />

          <button class="btn btn-primary submit-widget button-field context"
                  name="submit"
                  type="submit"
                  value="export"
                  i18n:attributes="value"
                  i18n:translate=""
          >Export
          </button>

        </div>

        <div metal:use-macro="context/@@exportimport_urban_config_links/links">
              Links to all exports and imports
        </div>

      </form>

    </tal:main-macro>
  </div>

</html>
