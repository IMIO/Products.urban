<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="collective.exportimport"
>

  <div metal:fill-slot="main">
    <tal:main-macro metal:define-macro="main">

      <h1 class="documentFirstHeading"
          tal:content="python: view.title"
          i18n:translate=""
      >
           Export other
      </h1>

      <form action="@@export_other"
            enctype="multipart/form-data"
            method="post"
            tal:attributes="
              action request/URL;
            "
      >
        <div class="field mb-3">
          <div class="form-check">
            <input class="form-check-input"
                   id="download_local"
                   checked="checked"
                   name="download_to_server:int"
                   type="radio"
                   value="0"
            />
            <label class="form-check-label"
                   for="download_local"
                   i18n:translate=""
            >
                  Download to local machine
            </label>
          </div>
          <div class="form-check">
            <input class="form-check-input"
                   id="download_server"
                   name="download_to_server:int"
                   type="radio"
                   value="1"
            />
            <label class="form-check-label"
                   for="download_server"
                   i18n:translate=""
            >
                  Save to file on server
            </label>
          </div>
        </div>

        <div class="form-group">
          <button class="btn btn-primary submit-widget button-field context"
                  name="form.submitted"
                  type="submit"
                  value="Export"
                  tal:content="python: view.title"
                  i18n:attributes="value"
                  i18n:translate=""
          >Export
          </button>
        </div>
      </form>

      <div metal:use-macro="context/@@exportimport_urban_config_links/links">
          Links to all exports and imports
      </div>

      <div tal:define="
             help_text python: getattr(view, 'help_text', None);
           "
           tal:condition="python: help_text"
      >
        <h3 i18n:translate="">Help</h3>
        <div tal:replace="structure python: help_text"></div>
      </div>

    </tal:main-macro>
  </div>

</html>
