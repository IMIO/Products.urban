<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="collective.exportimport"
>

  <div metal:fill-slot="main">
    <tal:main-macro metal:define-macro="main">

      <h1 class="documentFirstHeading"
          i18n:translate=""
      >Import Urban Config</h1>

      <p class="documentDescription"
         i18n:translate=""
      >Here you can upload a json-file.</p>

      <form action="."
            enctype="multipart/form-data"
            method="post"
            tal:attributes="
              action request/URL;
            "
      >
        <div class="form-group">
          <input name="jsonfile"
                 type="file"
          /><br />
        </div>

        <tal:block define="
                     server_files view/server_files;
                   ">
          <p i18n:translate="server_paths_list">Or you can choose a file that is already uploaded on the server in one of these paths:</p>
          <ul>
            <li tal:repeat="path view/import_paths"><code tal:content="path"></code></li>
          </ul>
          <p tal:condition="not:server_files"
             i18n:translate=""
          >No files found.</p>
          <div class="field mb-3"
               tal:condition="server_files"
          >
            <label for="server_file"
                   i18n:translate=""
            >File on server to import:</label>
            <br />
            <select id="server_file"
                    name="server_file"
            >
              <option selected
                      title=""
                      value=""
                      i18n:translate=""
              >Choose one</option>
              <option tal:repeat="filename server_files"
                      tal:content="filename"
                      tal:attributes="
                        value filename;
                      "
              >
              </option>
            </select>
          </div>
        </tal:block>


        <div class="field mb-3">
          <label for="include_blobs"
                 i18n:translate=""
          >Handle existing content</label>
          <span class="formHelp"
                i18n:translate=""
          >
                  How should content be handled that exists with the same id/path?
          </span>
          <div class="widget">
            <select class=""
                    name="handle_existing_content"
            >
              <option value="0"
                      tal:repeat="current python:view.handle_existing_content_options"
                      tal:content="python:current[1]"
                      tal:attributes="
                        value python: current[0];
                        selected python:'selected' if int(current[0]) == view.handle_existing_content else False;
                      "
              >
                        0
              </option>
            </select>
          </div>
        </div>

        <div class="field mb-3">
          <label for="include_blobs"
                 i18n:translate=""
          >Handle in case of missing parrent</label>
          <span class="formHelp"
                i18n:translate=""
          >
                  How should content be handled if the parent is missing?
          </span>
          <div class="widget">
            <select class=""
                    name="handle_missing_parent"
            >
              <option value="0"
                      tal:repeat="current python:view.handle_missing_parent_options"
                      tal:content="python:current[1]"
                      tal:attributes="
                        value python: current[0];
                        selected python:'selected' if int(current[0]) == view.handle_missing_parent else False;
                      "
              >
                        0
              </option>
            </select>
          </div>
        </div>

        <div class="field mb-3">
          <label for="commit"
                 i18n:translate=""
          >Do a commit after each number of items</label>
          <div class="widget">
            <input id="commit"
                   name="commit"
                   size="5"
                   type="text"
                   value=""
                   tal:attributes="
                     value python:view.commit;
                   "
            />
          </div>
        </div>

        <div class="field">
          <label>
            <input id="import_in_same_instance"
                   name="import_in_same_instance:boolean"
                   type="checkbox"
                   tal:attributes="
                     checked python:'checked' if view.import_in_same_instance else None;
                   "
            />
            <span i18n:translate="">Import in the same instance from export</span>
          </label>
        </div>

        <div class="field">
          <label>
            <input id="import_to_current_lic_config_folder"
                   name="import_to_current_lic_config_folder:boolean"
                   type="checkbox"
                   tal:attributes="
                     checked python:'checked' if view.import_to_current_lic_config_folder else None;
                   "
            />
            <span i18n:translate="">Import all items into the current licence config folder</span>
          </label>
        </div>

        <div class="field">
          <label>
            <input id="import_to_current_folder"
                   name="import_to_current_folder:boolean"
                   type="checkbox"
                   tal:attributes="
                     checked python:'checked' if view.import_to_current_folder else None;
                   "
            />
            <span i18n:translate="">Import all items into the current folder</span>
          </label>
        </div>

        <div class="field">
          <label>
            <input id="fix_parent_path"
                   name="fix_parent_path:boolean"
                   type="checkbox"
                   tal:attributes="
                     checked python:'checked' if view.fix_parent_path else None;
                   "
            />
            <span i18n:translate="">Fix parent path</span>
          </label>
        </div>

        <div class="form-group">
          <input name="form.submitted"
                 type="hidden"
                 value="1"
          />
          <button class="btn btn-primary submit-widget button-field context"
                  name="submit"
                  type="submit"
                  value="Import"
                  i18n:attributes="value"
                  i18n:translate=""
          >Import
          </button>
        </div>

      </form>

      <div metal:use-macro="context/@@exportimport_urban_config_links/links">
          Links to all exports and imports
      </div>

    </tal:main-macro>
  </div>

</html>
