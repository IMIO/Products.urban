<?xml version="1.0" encoding="utf-8"?>
<object xmlns:i18n="http://xml.zope.org/namespaces/i18n"
        meta_type="Plone Actions Tool"
        name="portal_actions"
>
  <action-provider name="portal_actions" />
  <object meta_type="CMF Action Category"
          name="portal_tabs"
  >
    <property name="title" />
    <object meta_type="CMF Action"
            name="urban"
            i18n:domain="urban"
    >
      <property name="title"
                i18n:translate=""
      >urban</property>
      <property name="description"
                i18n:translate=""
      />
      <property name="url_expr">string:$portal_url/urban</property>
      <property name="icon_expr" />
      <property name="available_expr">context/@@mayAccessUrban</property>
      <property name="permissions">
        <element value="View" />
      </property>
      <property name="visible">True</property>
    </object>
  </object>
  <object meta_type="CMF Action Category"
          name="user"
  >
    <object insert-before="logout"
            meta_type="CMF Action"
            name="Documentation"
    >
      <property name="title">Documentation</property>
      <property name="description" />
      <property name="url_expr">string:https://docs.imio.be/imio-doc/ia.urban/</property>
      <property name="link_target">https://docs.imio.be/imio-doc/ia.urban/</property>
      <property name="icon_expr" />
      <property name="available_expr" />
      <property name="permissions">
        <element value="View" />
      </property>
      <property name="visible">True</property>
    </object>
  </object>
  <object meta_type="CMF Action Category"
          name="object"
  >
    <property name="title" />
    <object meta_type="CMF Action"
            name="folderContents"
            i18n:domain="plone"
    >
      <property name="title"
                i18n:translate=""
      >Contents</property>
      <property name="description"
                i18n:translate=""
      />
      <property name="url_expr">string:${globals_view/getCurrentFolderUrl}/folder_contents</property>
      <property name="link_target" />
      <property name="icon_expr" />
      <property name="available_expr">python: context.portal_urban.is_admin() or ('portal_urban' in globals_view.getCurrentFolderUrl() and context.portal_urban.can_edit())</property>
      <property name="permissions">
   </property>
      <property name="visible">True</property>
    </object>
    <object meta_type="CMF Action"
            name="urbanmap"
            i18n:domain="urban"
    >
      <property name="title"
                i18n:translate=""
      >Map</property>
      <property name="description"
                i18n:translate=""
      />
      <property name="url_expr">string:$object_url/map</property>
      <property name="icon_expr" />
      <property name="available_expr">python: context.portal_type in context.portal_urban.getUrbanTypes()</property>
      <property name="permissions">
        <element value="View" />
      </property>
      <property name="visible">True</property>
    </object>
  </object>
  <object meta_type="CMF Action Category"
          name="document_actions"
  >
    <property name="title" />
    <object meta_type="CMF Action"
            name="urban_templates"
            i18n:domain="urban"
    >
      <property name="title"
                i18n:translate="templates_summary_title"
      >Templates summary</property>
      <property name="description"
                i18n:translate=""
      />
      <property name="url_expr">string:$object_url/@@templatessum</property>
      <property name="icon_expr">string:$portal_url/warning.png</property>
      <property name="available_expr">python: context.portal_type == 'UrbanTool'</property>
      <property name="permissions">
        <element value="View" />
      </property>
      <property name="visible">True</property>
    </object>
  </object>
  <object meta_type="CMF Action Category"
          name="document_actions"
  >
    <property name="title" />
    <object meta_type="CMF Action"
            name="urban_contact_emails"
            i18n:domain="urban"
    >
      <property name="title"
                i18n:translate=""
      >Emails</property>
      <property name="description"
                i18n:translate=""
      />
      <property name="url_expr">string:$object_url/getemails</property>
      <property name="icon_expr">string:$portal_url/getemails.png</property>
      <property name="available_expr">python: context.portal_urban.isContactFolder(context)</property>
      <property name="permissions">
        <element value="View" />
      </property>
      <property name="visible">True</property>
    </object>
  </object>
  <object meta_type="CMF Action Category"
          name="object_buttons"
  >
    <property name="title" />
    <object meta_type="CMF Action"
            name="urban_duplicate_licence"
            i18n:domain="urban"
    >
      <property name="title"
                i18n:translate=""
      >Duplicate licence</property>
      <property name="description"
                i18n:translate=""
      />
      <property name="url_expr">string:$object_url/duplicate_licence</property>
      <property name="icon_expr">string:$portal_url/duplicate_licence.png</property>
      <property name="available_expr">python: context.portal_urban.isLicence(context)</property>
      <property name="permissions">
        <element value="View" />
      </property>
      <property name="visible">True</property>
    </object>
  </object>
  <object meta_type="CMF Action Category"
          name="object_buttons"
  >
    <property name="title" />
    <object meta_type="CMF Action"
            name="copy_to_claimant"
            i18n:domain="urban"
    >
      <property name="title"
                i18n:translate=""
      >Copy to claimant</property>
      <property name="description"
                i18n:translate=""
      />
      <property name="url_expr">string:$object_url/copy_recipient_to_claimant</property>
      <property name="icon_expr">string:$portal_url/copytoclaymants.png</property>
      <property name="available_expr">python: context.portal_type == 'RecipientCadastre'</property>
      <property name="permissions">
        <element value="View" />
      </property>
      <property name="visible">True</property>
    </object>
    <object meta_type="CMF Action"
            name="send_mail_action"
            i18n:domain="urban"
    >
      <property name="title"
                i18n:translate=""
      >Send mail</property>
      <property name="description"
                i18n:translate=""
      />
      <property name="url_expr">string:$object_url/@@send-email-to-inquiry-dept</property>
      <property name="icon_expr">string:$portal_url/getemails.png</property>
      <property name="available_expr">python: context.portal_urban.check_if_mail_content_rule_applied(context)</property>
      <property name="permissions">
        <element value="View" />
      </property>
      <property name="visible">True</property>
    </object>
    <object meta_type="CMF Action"
            name="transfer_folder_to_dpa"
            i18n:domain="urban"
    >
      <property name="title"
                i18n:translate=""
      >Transfer folder to DPA</property>
      <property name="description"
                i18n:translate=""
      />
      <property name="url_expr">string:$object_url/@@transfer_folder_to_dpa</property>
      <property name="icon_expr">string:$portal_url/copytoclaymants.png</property>
      <property name="available_expr">context/@@can_transfer_folder_to_dpa</property>
      <property name="permissions">
        <element value="View" />
      </property>
      <property name="visible">True</property>
    </object>
  </object>
</object>
