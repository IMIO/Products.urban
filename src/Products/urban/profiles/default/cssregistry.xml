<?xml version="1.0" encoding="utf-8"?>
<object meta_type="Stylesheets Registry"
        name="portal_css"
>
  <!-- EXAMPLE DEFINITION
 <stylesheet title=""
             cacheable="True"
             compression="safe"
             cookable="True"
             enabled="1"
             expression=""
             id="myfancystyle.css"
             media="all"
             rel="stylesheet"
             rendering="import"/>
 -->

  <!-- ##code-section cssregistry.xml -->

  <stylesheet id="urbanlicences.css"
              cacheable="True"
              compression="safe"
              cookable="True"
              enabled="1"
              expression="python: not context.restrictedTraverse('@@plone_portal_state').anonymous() and here.portal_type in context.portal_urban.getUrbanTypes() + ['UrbanEvent', 'UrbanEventInquiry', 'Applicant', 'Architect', 'Geometrician', 'FolderManager', 'Notary', 'Parcel', ] and not member.has_role('Manager')"
              media="all"
              rel="stylesheet"
              rendering="import"
              title="urban licences CSS"
  />

  <stylesheet id="urban_hide_columnone.css"
              cacheable="True"
              compression="safe"
              cookable="True"
              enabled="1"
              expression="python: here.meta_type in ['BuildLicence', 'ParcelOutLicence', 'UrbanEvent', 'Parcel', 'Contact', 'UrbanCertificateBase', 'UrbanCertificateTwo', 'Declaration', 'Division', 'EnvironmentBase', ]"
              media="all"
              rel="stylesheet"
              rendering="import"
              title="urban_hide_columnone.css"
  />

  <!-- ##/code-section cssregistry.xml -->
</object>
