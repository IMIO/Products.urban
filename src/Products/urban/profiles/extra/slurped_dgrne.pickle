49">Alternative 2 : mise en oeuvre sans fourniture des mat\xc3\xa9riaux<sup>2</sup>\n</td>\n<td width="69">S x 0,7 m </td>\n<td width="46">m<sup>3</sup> </td>\n<td width="57">\xc2\xa0 </td>\n<td width="83">\xc2\xa04,00 </td>\n<td width="40">\xc2\xa0</td>\n</tr>\n<tr>\n<td width="249">Alternative 1 : mise en oeuvre avec fourniture des mat\xc3\xa9riaux </td>\n<td width="69">S x 0,7 m </td>\n<td width="46">m<sup>3</sup> </td>\n<td width="57">\xc2\xa0 </td>\n<td width="83">\xc2\xa016,00 </td>\n<td width="40">\xc2\xa0</td>\n</tr>\n<tr>\n<td width="249">Alternative 2 : mise en oeuvre sans fourniture des mat\xc3\xa9riaux<sup>2</sup>\n</td>\n<td width="69">S x 0,7 m </td>\n<td width="46">m<sup>3</sup> </td>\n<td width="57">\xc2\xa0 </td>\n<td width="83">\xc2\xa04,00 </td>\n<td width="40">\xc2\xa0</td>\n</tr>\n<tr>\n<td width="260">A4. Engazonnement </td>\n<td width="249">- </td>\n<td width="69">\xc2\xa0 </td>\n<td width="46">\xc2\xa0m<sup>2</sup> </td>\n<td width="57">\xc2\xa0 </td>\n<td width="83">\xc2\xa00,60 </td>\n<td width="40">\xc2\xa0</td>\n</tr>\n<tr>\n<td width="260">A5. Pose de bornes pour le nivellement topographique </td>\n<td width="249">- </td>\n<td width="69">16/ha </td>\n<td width="46">pi\xc3\xa8ce </td>\n<td width="57">\xc2\xa0 </td>\n<td width="83">\xc2\xa075,00 </td>\n<td width="40">\xc2\xa0</td>\n</tr>\n<tr>\n<td width="260">A6. R\xc3\xa9seau de d\xc3\xa9gazage (4) </td>\n<td width="249">Raccord des puits \xc3\xa0 gaz \xc3\xa0 la torch\xc3\xa8re (tuyauteries et accessoires) </td>\n<td width="69">200 m/ha </td>\n<td width="46">m </td>\n<td width="57">\xc2\xa0 </td>\n<td width="83">\xc2\xa050,00 </td>\n<td width="40">\xc2\xa0</td>\n</tr>\n<tr>\n<td width="260">A7. R\xc3\xa9cup\xc3\xa9ration des eaux de ruissellement </td>\n<td width="249">Foss\xc3\xa9s p\xc3\xa9riph\xc3\xa9riques </td>\n<td width="69">120 m/ha </td>\n<td width="46">m </td>\n<td width="57">\xc2\xa0 </td>\n<td width="83">\xc2\xa045,00 </td>\n<td width="40">\xc2\xa0</td>\n</tr>\n</table>\n<p class="justifie">2. Remise en \xc3\xa9tat d\xc3\xa9finitive.</p>\n<table border="1" bordercolor="#111111" cellpadding="3" cellspacing="3" style="border-collapse: collapse" width="100%">\n<tr>\n<th width="147">B. Couverture d\xc3\xa9finitive (5)</th>\n<th width="423">Quand le taux annuel de tassement relatif est inf\xc3\xa9rieur \xc3\xa0 \r\n    1,5 % sur l\'ensemble du site apr\xc3\xa8s la fin d\xc3\xa9finitive des d\xc3\xa9versements et la \r\n    pose de la couverture provisoire </th>\n<th width="84">\xc2\xa0 </th>\n<th width="50">\xc2\xa0</th><th width="26">\xc2\xa0\r\n    </th><th width="60">\xc2\xa0 </th>\n<th width="15">\xc2\xa0 </th>\n</tr>\n<tr>\n<td rowspan="4" width="147">B1. Travaux pr\xc3\xa9paratoires (6) </td>\n<td width="423">Adaptation provisoire du r\xc3\xa9seau de d\xc3\xa9gazage </td>\n<td width="84">- </td>\n<td width="50">ha </td>\n<td width="26">\xc2\xa0 </td>\n<td width="60">\xc2\xa06200,00 </td>\n<td width="15">\xc2\xa0</td>\n</tr>\n<tr>\n<td width="423">Enl\xc3\xa8vement et stockage de la couche provisoire de terres de \r\n    2<sup>nd</sup> cat\xc3\xa9gorie </td>\n<td width="84">S x 0,6 m </td>\n<td width="50">m<sup>3</sup> </td>\n<td width="26">\xc2\xa0 </td>\n<td width="60">\xc2\xa05,00 </td>\n<td width="15">\xc2\xa0</td>\n</tr>\n<tr>\n<td width="423">Reprofilage g\xc3\xa9n\xc3\xa9ral </td>\n<td width="84">- </td>\n<td width="50">m<sup>2</sup> </td>\n<td width="26">\xc2\xa0 </td>\n<td width="60">\xc2\xa00,50 </td>\n<td width="15">\xc2\xa0</td>\n</tr>\n<tr>\n<td width="423">Comblement et mise \xc3\xa0 niveau d\xc3\xa9finitif (avec du limon) </td>\n<td width="84">S x 1,5 m </td>\n<td width="50">m<sup>3</sup> </td>\n<td width="26">\xc2\xa0 </td>\n<td width="60">\xc2\xa07,5 </td>\n<td width="15">\xc2\xa0 </td>\n</tr>\n<tr>\n<td rowspan="4" width="147">B2. Couche drainante gaz </td>\n<td width="423">Alternative 1 : nappe drainante naturelle </td>\n<td width="84">\xc2\xa0 </td>\n<td width="50">\xc2\xa0 </td>\n<td width="26">\xc2\xa0 </td>\n<td 