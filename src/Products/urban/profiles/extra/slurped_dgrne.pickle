lign="top" width="22%"><i>Tilia \r\n    platyphyllos</i></td>\n<td height="26" valign="top" width="9%"><i>\n</i><p class="centrer">30 (40)</p></td>\n<td height="26" valign="top" width="22%">\n<p align="left">sols riches, calcaires, aux endroits chauds</p></td>\n<td height="26" valign="top" width="23%">\xc2\xa0</td>\n</tr>\n<tr>\n<td height="16" valign="top" width="23%">Orme de montagne</td>\n<td height="16" valign="top" width="22%"><i>Ulmus glabra</i></td>\n<td height="16" valign="top" width="9%"><i>\n</i><p class="centrer">30</p></td>\n<td height="16" valign="top" width="22%">\n<p align="left">versants en exposition Nord</p></td>\n<td height="16" valign="top" width="23%"></td>\n</tr>\n<tr>\n<td height="17" valign="top" width="23%">Orme champ\xc3\xaatre</td>\n<td height="17" valign="top" width="22%"><i>Ulmus minor</i></td>\n<td height="17" valign="top" width="9%"><i>\n</i><p align="left">10 - 30</p></td>\n<td height="17" valign="top" width="22%">\n<p align="left">sur sols vari\xc3\xa9s, mais toujours frais</p></td>\n<td height="17" valign="top" width="23%"></td>\n</tr>\n<tr>\n<td height="26" valign="top" width="23%">Viorne lantane</td>\n<td height="26" valign="top" width="22%"><i>Viburnum lantana</i></td>\n<td height="26" valign="top" width="9%"><i>1 - 4</i></td>\n<td height="26" valign="top" width="22%">\n<p align="left">sur sols calcaires, secs ou tr\xc3\xa8s secs</p></td>\n<td height="26" valign="top" width="23%">\n<p align="left">pas au Nord du Sillon Sambre-et-Meuse</p></td>\n</tr>\n<tr>\n<td height="25" valign="top" width="23%">Viorne obier</td>\n<td height="25" valign="top" width="22%"><i>Viburnum opulus</i></td>\n<td height="25" valign="top" width="9%"><i>1 - 4</i></td>\n<td height="25" valign="top" width="22%">\n<p align="left">sur sols vari\xc3\xa9s, frais ou humides</p></td>\n<td height="25" valign="top" width="23%">\xc2\xa0</td>\n</tr>\n</table>\n<p class="centrer">___________</p>\n<p class="centrer"><strong>ANNEXE 2</strong></p>\n<p class="justifie"><strong>L\xc3\xa9gumineuses </strong>(Fabaceae )</p>\n<p class="justifie">La liste des l\xc3\xa9gumineuses est limit\xc3\xa9e \xc3\xa0 4 esp\xc3\xa8ces, peu \r\nenvahissantes, et ne g\xc3\xa9n\xc3\xa9rant pas une rud\xc3\xa9ralisation du milieu par fixation trop \r\nimportante du milieu.</p>\n<p class="justifie"><i>Trifolium incarnatum </i>\r\n\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0 Tr\xc3\xa8fle incarnat<br/>\n<i>Lotus corniculatus subsp. corniculatus</i>\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0 Lotier cornicul\xc3\xa9<br/>\n<i>Anthyllis vulneraria\xc2\xa0 </i>\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0 \r\nVuln\xc3\xa9raire<br/>\n<i>Onobrychis viciifolia </i>\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0 Sainfoin\r\n</p>\n<p class="centrer">_____________</p>\n<p class="centrer"><strong>ANNEXE 3</strong></p>\n<p class="justifie"><strong>Gramin\xc3\xa9es</strong></p>\n<p class="justifie">Seules les esp\xc3\xa8ces de gramin\xc3\xa9es de cette liste sont \r\nautoris\xc3\xa9es. Les esp\xc3\xa8ces ne figurant pas dans cette liste, mais se rencontrant \r\nhabituellement dans les m\xc3\xa9langes propos\xc3\xa9s dans le commerce, ont \xc3\xa9t\xc3\xa9 \xc3\xa9cart\xc3\xa9es du \r\nfait de leur trop grande productivit\xc3\xa9, emp\xc3\xaachant tout d\xc3\xa9veloppement ult\xc3\xa9rieur \r\nd\'une v\xc3\xa9g\xc3\xa9tation naturelle riche et diversifi\xc3\xa9e.</p>\n<p class="justifie"><i>Anthoxanthum odoratum </i>\r\n\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0 Flouve odorante<br/>\n<i>Alopecurus pratensis\xc2\xa0 </i>\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0 Vulpin \r\ndes pr\xc3\xa9s<br/>\n<i>Agrostis tenuis </i>\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0 \r\nAgrostis commun<br/>\n<i>Agrostis stolonifera </i>\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0 \r\nAgrostis stolonif\xc3\xa8re<br/>\n<i>Poa trivialis\xc2\xa0 </i>\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\xa0\xc2\