         title="closed"
         i18n:attributes="title"
  >
    <exit-transition transition_id="reopen" />
    <permission-map acquired="False"
                    name="ATContentTypes: Add File"
    >
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="ATContentTypes: Add Image"
    >
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="Access contents information"
    >
      <permission-role>Reader</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="Add portal content"
    >
      <permission-role>Editor</permission-role>
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="Delete objects"
    >
      <permission-role>Editor</permission-role>
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="Modify portal content"
    >
      <permission-role>Editor</permission-role>
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="View"
    >
      <permission-role>Reader</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="WebDAV Lock items"
    >
      <permission-role>Editor</permission-role>
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="WebDAV Unlock items"
    >
      <permission-role>Editor</permission-role>
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
  </state>
  <state state_id="decision_in_progress"
         title="decision_in_progress"
         i18n:attributes="title"
  >
    <exit-transition transition_id="receive_college_decision" />
    <permission-map acquired="False"
                    name="ATContentTypes: Add File"
    >
      <permission-role>Editor</permission-role>
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="ATContentTypes: Add Image"
    >
      <permission-role>Editor</permission-role>
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="Access contents information"
    >
      <permission-role>Reader</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="Add portal content"
    >
      <permission-role>Editor</permission-role>
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="Delete objects"
    >
      <permission-role>Editor</permission-role>
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="Modify portal content"
    >
      <permission-role>Editor</permission-role>
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="Products.urban: SendToPM"
    >
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="View"
    >
      <permission-role>Reader</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="WebDAV Lock items"
    >
      <permission-role>Editor</permission-role>
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="WebDAV Unlock items"
    >
      <permission-role>Editor</permission-role>
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
  </state>
  <state state_id="draft"
         title="draft"
         i18n:attributes="title"
  >
    <exit-transition transition_id="propose" />
    <permission-map acquired="False"
                    name="ATContentTypes: Add File"
    >
      <permission-role>Editor</permission-role>
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
      <permission-role>Owner</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="ATContentTypes: Add Image"
    >
      <permission-role>Editor</permission-role>
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
      <permission-role>Owner</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="Access contents information"
    >
      <permission-role>Reader</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
      <permission-role>Owner</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="Add portal content"
    >
      <permission-role>Editor</permission-role>
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
      <permission-role>Owner</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="Delete objects"
    >
      <permission-role>Editor</permission-role>
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
      <permission-role>Owner</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="Modify portal content"
    >
      <permission-role>Editor</permission-role>
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
      <permission-role>Owner</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="View"
    >
      <permission-role>Reader</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Contributor</permission-role>
      <permission-role>Manager</permission-role>
      <permission-role>Owner</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="WebDAV Lock items"
    >
      <permission-role>Editor</permission-role>
