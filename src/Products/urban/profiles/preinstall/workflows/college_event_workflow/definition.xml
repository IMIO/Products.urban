<?xml version="1.0" encoding="utf-8"?>
<dc-workflow xmlns:i18n="http://xml.zope.org/namespaces/i18n"
             description=""
             initial_state="draft"
             manager_bypass="False"
             state_variable="review_state"
             title="college_event_workflow"
             workflow_id="college_event_workflow"
             i18n:domain="plone"
