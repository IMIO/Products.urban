<?xml version="1.0" encoding="utf-8"?>
<object xmlns:i18n="http://xml.zope.org/namespaces/i18n"
        meta_type="Dexterity FTI"
        name="UrbanTemplate"
        i18n:domain="plone"
>
  <property name="title"
