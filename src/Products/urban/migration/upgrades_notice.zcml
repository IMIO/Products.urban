<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:gs="http://namespaces.zope.org/genericsetup"
    i18n_domain="urban"
    >

  <gs:upgradeStep
      title="Add configuration for notice settings"
      description="Initialize registry for notice settings"
      profile="Products.urban:default"
      source="*"
      destination="2900"
      handler=".update_290.initialize_notice_settings"
      />

  <gs:upgradeStep
      title="Add event config types for notice"
      description="Add event config types for notice"
      profile="Products.urban:default"
      source="2900"
      destination="2901"
      handler=".update_290.add_event_config_types_notice"
      />

  <gs:upgradeStep
      title="Add folder manager for notice import"
      description=""
      profile="Products.urban:default"
      source="2901"
      destination="2902"
      handler=".update_290.add_folder_manager_notice"
      />

</configure>
