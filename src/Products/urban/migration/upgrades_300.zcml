<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:gs="http://namespaces.zope.org/genericsetup"
    i18n_domain="urban"
    >

  <gs:upgradeSteps
      source="1206"
      destination="1207"
      profile="Products.urban:default"
      >
        <gs:upgradeStep
          title="Install imio.urban.core"
          handler=".update_300.install_urban_core"
          />
        <gs:upgradeStep
          title="Migration to DX - PortionOut"
          handler=".migrate_to_DX.migrate_PortionOut_to_DX"
          />
        <gs:upgradeStep
          title="Migration to DX - ParcellingTerm"
          handler=".migrate_to_DX.migrate_ParcellingTerm_to_DX"
          />
        <gs:upgradeStep
          title="Migrate parcellings folder allowed type"
          handler=".migrate_to_250.migrate_parcellings_folder_allowed_type"
          />
        <gs:upgradeStep
          title="Migration to DX - UrbanEventType"
          handler=".migrate_to_DX.migrate_UrbanEventType_to_DX"
          />
        <gs:upgradeStep
          title="Migration urbaneventtypes folder"
          handler=".migrate_to_250.migrate_urbaneventtypes_folder"
          />
  </gs:upgradeSteps>

  <gs:upgradeStep
      title="Set missing registry record for off days"
      description=""
      profile="Products.urban:default"
      source="1207"
      destination="1208"
      handler=".update_300.add_missing_registry_record"
      />

  <gs:upgradeStep
      title="Change event config folder allowed types"
      description=""
      profile="Products.urban:default"
      source="1208"
      destination="1209"
      handler=".update_300.change_event_config_folder_allowed_types"
      />

  <gs:upgradeStep
      title="Reimport typeinfo profil"
      description=""
      profile="Products.urban:default"
      source="1209"
      destination="1210"
      handler=".update_300.reimport_typeinfo"
      />

  <gs:upgradeStep
      title="Fix parcelling changesDescription field"
      description=""
      profile="Products.urban:default"
      source="1210"
      destination="1211"
      handler=".update_300.fix_parcelling_changesDescription_field"
      />

  <gs:upgradeStep
      title="Set additionalReference as an optional field"
      description="Activate additionalReference for all licences types"
      profile="Products.urban:default"
      source="*"
      destination="3000"
      handler=".update_300.set_additional_reference_as_default"
      />

</configure>
