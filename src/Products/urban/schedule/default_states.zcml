<configure
    xmlns="http://namespaces.zope.org/zope"
    i18n_domain="liege.urban"
    >

  <adapter
      factory=".default_states.LicencesDefaultFreezeStates"
      provides="imio.schedule.interfaces.IDefaultFreezeStates"
      for="Products.urban.interfaces.IGenericLicence"
      />

  <adapter
      factory=".default_states.LicencesDefaultThawStates"
      provides="imio.schedule.interfaces.IDefaultThawStates"
      for="Products.urban.interfaces.IGenericLicence"
      />

</configure>
