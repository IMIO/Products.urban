<configure
    xmlns="http://namespaces.zope.org/zope"
    i18n_domain="Products.urban"
    >

  <!-- Vocabulary of base searches for schedule faceted view -->
  <utility
      factory=".vocabulary.UsersFromGroupsVocabularyFactory"
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="urban.schedule_users"
      />

  <utility
      factory=".vocabulary.OpinionUsersVocabularyFactory"
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="urban.internal_opinions_users"
      />

</configure>
