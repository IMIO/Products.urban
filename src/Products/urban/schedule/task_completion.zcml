<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="urban"
    >

  <configure package="imio.schedule">

    <browser:page
        name="end_status"
        for="Products.urban.schedule.interfaces.ISendOpinionRequestsTask"
        class="Products.urban.schedule.task_completion.OpinionRequestSentStatus"
        template="browser/templates/task_completion.pt"
        permission="zope2.View"
        />

    <browser:page
        name="simple_end_status"
        for="Products.urban.schedule.interfaces.ISendOpinionRequestsTask"
        class="Products.urban.schedule.task_completion.OpinionRequestSentStatus"
        template="browser/templates/task_completion.pt"
        permission="zope2.View"
        />

    <browser:page
        name="end_status"
        for="Products.urban.schedule.interfaces.IReceiveOpinionRequestsTask"
        class="Products.urban.schedule.task_completion.OpinionRequestReceivedStatus"
        template="browser/templates/task_completion.pt"
        permission="zope2.View"
        />

    <browser:page
        name="simple_end_status"
        for="Products.urban.schedule.interfaces.IReceiveOpinionRequestsTask"
        class="Products.urban.schedule.task_completion.OpinionRequestReceivedStatus"
        template="browser/templates/task_completion.pt"
        permission="zope2.View"
        />

    <browser:page
        name="end_status"
        for="Products.urban.schedule.interfaces.ICreateFollowupTask"
        class="Products.urban.schedule.task_completion.FollowupEventsRedactedStatus"
        template="browser/templates/task_completion.pt"
        permission="zope2.View"
        />

    <browser:page
        name="simple_end_status"
        for="Products.urban.schedule.interfaces.ICreateFollowupTask"
        class="Products.urban.schedule.task_completion.FollowupEventsRedactedStatus"
        template="browser/templates/task_completion.pt"
        permission="zope2.View"
        />

    <browser:page
        name="end_status"
        for="Products.urban.schedule.interfaces.IValidateFollowupTask"
        class="Products.urban.schedule.task_completion.FollowupEventsValidatedStatus"
        template="browser/templates/task_completion.pt"
        permission="zope2.View"
        />

    <browser:page
        name="simple_end_status"
        for="Products.urban.schedule.interfaces.IValidateFollowupTask"
        class="Products.urban.schedule.task_completion.FollowupEventsValidatedStatus"
        template="browser/templates/task_completion.pt"
        permission="zope2.View"
        />

    <browser:page
        name="end_status"
        for="Products.urban.schedule.interfaces.ISendFollowupTask"
        class="Products.urban.schedule.task_completion.FollowupEventsSentStatus"
        template="browser/templates/task_completion.pt"
        permission="zope2.View"
        />

    <browser:page
        name="simple_end_status"
        for="Products.urban.schedule.interfaces.ISendFollowupTask"
        class="Products.urban.schedule.task_completion.FollowupEventsSentStatus"
        template="browser/templates/task_completion.pt"
        permission="zope2.View"
        />

  </configure>

</configure>
