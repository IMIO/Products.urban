      for="Products.urban.interfaces.IInspection
           imio.schedule.content.task_config.ITaskConfig"
      name="urban.schedule.condition.should_write_one_followup"
      />

  <adapter
      factory=".creation.SomeInspectionFollowupsAreWritten"
