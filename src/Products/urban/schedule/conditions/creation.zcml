      for="Products.urban.interfaces.IEnvironmentLicence
           imio.schedule.content.task_config.ITaskConfig"
      name="urban.schedule.condition.opinion_requests_in_progress"
      />

  <adapter
      factory=".creation.OpinionRequestsDone"
