      name="urban.schedule.condition.authority_is_college"
      />

  <!-- Env class 2 temporary licences dont have public inquiries -->
  <adapter
      factory=".creation.IsNotTemporaryLicence"
      provides="imio.schedule.interfaces.ICreationCondition"
