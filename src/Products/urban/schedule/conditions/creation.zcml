      for="Products.urban.interfaces.ICODT_BaseBuildLicence
           imio.schedule.content.task_config.ITaskConfig"
      name="urban.schedule.condition.opinion_requests_done"
      />

  <adapter
      factory=".creation.OpinionRequestsDone"
