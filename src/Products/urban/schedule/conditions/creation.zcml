      for="Products.urban.interfaces.IBaseAllBuildLicence
           imio.schedule.content.task_config.ITaskConfig"
      name="urban.schedule.condition.FD_opinion_overdue"
      />

  <!-- deposit date is past by x days -->

  <adapter
