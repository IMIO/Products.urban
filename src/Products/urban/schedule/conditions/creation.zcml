      for="Products.urban.interfaces.IInspection
           imio.schedule.content.task_config.ITaskConfig"
      name="urban.schedule.condition.followup_ticket_is_closed"
      />

  <adapter
      factory=".creation.FollowUpWithDelayClosed"
