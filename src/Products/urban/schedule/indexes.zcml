<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    i18n_domain="urban"
    >

  <adapter
      factory=".indexes.licence_final_duedate"
      name="licence_final_duedate"
      />

  <adapter
      factory=".indexes.licence_reference_index"
      name="getReference"
      />

  <adapter
      factory=".indexes.licence_street_index"
      name="StreetsUID"
      />

  <adapter
      factory=".indexes.licence_streetnumber_index"
      name="StreetNumber"
      />

  <adapter
      factory=".indexes.licence_foldermanager_index"
      name="folder_manager"
      />

  <adapter
      factory=".indexes.licence_applicant_index"
      name="applicantInfosIndex"
      />

</configure>
