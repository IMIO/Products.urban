<metal:workflowstate define-macro="workflowState"
                     i18n:domain="plone"
>
  <div class="urban_workflowstate">
    <span i18n:translate="label_state"></span>&nbsp;
    <span tal:define="
            state view/get_state;
          "
          tal:content="state"
          tal:attributes="
            class string:urban_state_${state};
          "
          i18n:domain="plone"
          i18n:translate=""
    ></span>
  </div></metal:workflowstate>
