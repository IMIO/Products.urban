<metal:noticeTransmitDates define-macro="noticeTransmitDates" i18n:domain="urban">
  <fieldset>
    <legend i18n:translate="">NOTICe transmits</legend>
    <div class="clear" tal:define="transmits view/get_transmits">
      <table class="listing" tal:condition="transmits">
          <thead>
            <th i18n:translate="transmit_action">Action</th>
            <th i18n:translate="transmit_date">When</th>
            <th i18n:translate="transmit_user">User</th>
          </thead>
          <tbody>
            <tr tal:repeat="transmit transmits">
                <td tal:content="transmit/label"></td>
                <td tal:content="transmit/date"></td>
                <td tal:content="transmit/user"></td>
            </tr>
          </tbody>
      </table>
    </div>
  </fieldset>
</metal:noticeTransmitDates>
