<div id="urbain220-generation-view"
     tal:condition="view/available"
     i18n:domain="urban"
>
  <form method="POST"
        name="CopyToInspectionsForm"
        target="_blank"
        tal:attributes="
          action string:${context/absolute_url}/copy_to_inspections;
        "
  >
    <input name="template_uid"
           type="hidden"
    />
    <input name="output_format"
           type="hidden"
    />
    <input name="uids"
           type="hidden"
           value=""
    />
    <input name="facetedQuery"
           type="hidden"
           value=""
    />

    <ul class="pod-template">
      <li tal:repeat="infos view/get_links_info">
        <a href="#"
           style="cursor: pointer"
           tal:attributes="
             onclick string:event.preventDefault();;javascript:generatePodDocument('','', this);
           "
        >
          <img class="svg-icon"
               src="#"
               tal:attributes="
                 src string:${view/portal_url}/Ticket.png;
               "
          />
          <span tal:replace="infos/title">Template title</span>
        </a>
      </li>
    </ul>


  </form>
</div>
